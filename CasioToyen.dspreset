            <sample loNote="66" hiNote="67" rootNote="67" path="samples/kalimba_so.wav"/>
            <sample loNote="68" hiNote="69" rootNote="69" path="samples/kalimba_la.wav"/>
            <sample loNote="70" hiNote="71" rootNote="71" path="samples/kalimba_si.wav"/>
            <sample loNote="72" hiNote="72" rootNote="72" path="samples/kalimba_do2.wav"/>
            <!-- vrchní oktáva (nafejkovaná) -->
            <sample loNote="73" hiNote="74" rootNote="62" path="samples/kalimba_re.wav"/>
            <sample loNote="75" hiNote="76" rootNote="64" path="samples/kalimba_mi.wav"/>
            <sample loNote="77" hiNote="77" rootNote="65" path="samples/kalimba_fa.wav"/>
            <sample loNote="78" hiNote="79" rootNote="67" path="samples/kalimba_so.wav"/>
            <sample loNote="80" hiNote="81" rootNote="69" path="samples/kalimba_la.wav"/>
            <sample loNote="82" hiNote="83" rootNote="71" path="samples/kalimba_si.wav"/>
            <sample loNote="84" hiNote="89" rootNote="72" path="samples/kalimba_do2.wav"/>
        </group>
        <group tags="krystal">
            <!-- originální tóny (rozšířené dolů) -->
            <sample loNote="53" hiNote="60" rootNote="60" path="samples/krystal_do.wav"/>
            <sample loNote="61" hiNote="62" rootNote="62" path="samples/krystal_re.wav"/>
            <sample loNote="63" hiNote="64" rootNote="64" path="samples/krystal_mi.wav"/>
            <sample loNote="65" hiNote="65" rootNote="65" path="samples/krystal_fa.wav"/>
            <sample loNote="66" hiNote="67" rootNote="67" path="samples/krystal_so.wav"/>
            <sample loNote="68" hiNote="69" rootNote="69" path="samples/krystal_la.wav"/>
            <sample loNote="70" hiNote="71" rootNote="71" path="samples/krystal_si.wav"/>
            <sample loNote="72" hiNote="72" rootNote="72" path="samples/krystal_do2.wav"/>
            <!-- vrchní oktáva (nafejkovaná) -->
            <sample loNote="73" hiNote="74" rootNote="62" path="samples/krystal_re.wav"/>
            <sample loNote="75" hiNote="76" rootNote="64" path="samples/krystal_mi.wav"/>
            <sample loNote="77" hiNote="77" rootNote="65" path="samples/krystal_fa.wav"/>
            <sample loNote="78" hiNote="79" rootNote="67" path="samples/krystal_so.wav"/>
            <sample loNote="80" hiNote="81" rootNote="69" path="samples/krystal_la.wav"/>
            <sample loNote="82" hiNote="83" rootNote="71" path="samples/krystal_si.wav"/>
            <sample loNote="84" hiNote="89" rootNote="72" path="samples/krystal_do2.wav"/>
        </group>
        <group tags="noise">
            <sample loNote="29" hiNote="89" rootNote="60" path="samples/noise440f2.wav" loopEnabled="true"/>
        </group>
        <group tags="groan" seqMode="round_robin">
            <sample loNote="29" hiNote="89" rootNote="77" path="samples/groan_f4.wav" seqPosition="1"/>
            <sample loNote="29" hiNote="89" rootNote="77" path="samples/groan_f4_b.wav" seqPosition="2"/>
            <sample loNote="29" hiNote="89" rootNote="77" path="samples/groan_f4_c.wav" seqPosition="3"/>
        </group>
        <group tags="taisho">
            <sample loNote="43" hiNote="50" rootNote="43" path="samples/taisho_base.wav"/>
            <sample loNote="51" hiNote="55" rootNote="55" path="samples/taisho_g4.wav"/>
            <sample loNote="56" hiNote="57" rootNote="57" path="samples/taisho_a4.wav"/>
            <sample loNote="58" hiNote="59" rootNote="59" path="samples/taisho_h4.wav"/>
            <sample loNote="60" hiNote="60" rootNote="60" path="samples/taisho_c5.wav"/>
            <sample loNote="61" hiNote="62" rootNote="62" path="samples/taisho_d5.wav"/>
            <sample loNote="63" hiNote="64" rootNote="64" path="samples/taisho_e5.wav"/>
            <sample loNote="65" hiNote="65" rootNote="65" path="samples/taisho_f5.wav"/>
            <sample loNote="66" hiNote="67" rootNote="67" path="samples/taisho_g5.wav"/>
            <sample loNote="68" hiNote="69" rootNote="69" path="samples/taisho_a5.wav"/>
            <sample loNote="70" hiNote="71" rootNote="71" path="samples/taisho_h5.wav"/>
            <sample loNote="72" hiNote="72" rootNote="72" path="samples/taisho_c6.wav"/>
            <sample loNote="73" hiNote="74" rootNote="74" path="samples/taisho_d6.wav"/>
            <sample loNote="75" hiNote="76" rootNote="76" path="samples/taisho_e6.wav"/>
            <sample loNote="77" hiNote="77" rootNote="77" path="samples/taisho_f6.wav"/>
            <sample loNote="78" hiNote="79" rootNote="79" path="samples/taisho_g6.wav"/>
            <sample loNote="80" hiNote="81" rootNote="81" path="samples/taisho_a6.wav"/>

        </group>
    </groups>
    <modulators>
        <!-- wow and flutter LFOs -->
        <random mode="periodic" frequency="5" seed="12345" scope="global">
            <binding type="effect" level="instrument" effectIndex="5" parameter="FX_DELAY_TIME" modBehavior="add"
                     translation="linear" translationOutputMin="0" translationOutputMax="0.01"/>
        </random>
        <lfo shape="sine" frequency="0.5" modAmount="1.0">
            <binding type="effect" level="instrument" effectIndex="5" parameter="FX_DELAY_TIME" modBehavior="add"
                     translation="linear" translationOutputMin="0" translationOutputMax="0.01"/>
        </lfo>

        <!-- MODWHEEL -> FILTER -->
        <midiCC number="1" modAmount="0" channel="voice">
            <binding type="effect" level="instrument" effectIndex="0" parameter="FX_FILTER_FREQUENCY"
                     translation="table" translationTable="0,22000;0.3,11000;0.4,4100;0.5,1100;0.7,450;0.9,150;1.0001,33"/>
        </midiCC>

        <!-- MODWHEEL -> VOLUME -->
        <midiCC number="1" modAmount="0" channel="voice">
            <binding type="effect" level="instrument" effectIndex="1" parameter="LEVEL" modBehavior="multiply"
                     translation="linear" translationOutputMin="1" translationOutputMax="0"/>
        </midiCC>

       <!-- TIME TRAVEL -> DELAY TIME -->
        <midiCC number="1" modAmount="0" scope="global">
            <binding level="instrument" type="effect" effectIndex="2" parameter="FX_DELAY_TIME"
                     translation="linear" translationOutputMin="0" translationOutputMax="0.3"/>
        </midiCC>

        <!-- MODWHEEL -> DRIVE -->
        <midiCC number="1" modAmount="0" scope="global">
            <binding level="instrument" type="effect" effectIndex="3" parameter="FX_DRIVE"
                     translation="linear" translationOutputMin="1" translationOutputMax="60"/>
        </midiCC>

        <!-- volume slider -->
        <midiCC number="7" modAmount="1" scope="global">
            <binding level="ui" type="control" parameter="VALUE" tags="volumeslider"
                     translation="linear" translationOutputMin="0" translationOutputMax="1"/>
        </midiCC>

    </modulators>
    <effects>
        <!-- 0: mod filter -->
        <effect type="lowpass" frequency="22000.0"/>
        <!-- 1: mod amp -->
        <effect type="gain" levelUnit="linear" level="1"/>
        <!-- 2: mod time travel -->
        <effect type="delay" delayTime="0" feedback="0" wetLevel="0"/>
        <!-- 3: waveshaper -->
        <effect type="wave_shaper" drive="1" outputLevel="1"/>
        <!-- 4: slapback -->
        <effect type="delay" delayTime="0.02" feedback="0.95" wetLevel="0"/>
        <!-- 5: lofi -->
        <effect type="bit_crusher" bitDepth="12" sampleRateReduction="8" mix="0"/>
        <!-- 6: wow and flutter -->
        <effect type="delay" delayTime="0" feedback="0" wetLevel="0"/>
        <!-- 7: foldback -->
        <effect type="wave_folder" drive="1" threshold="1"/>
        <!-- 8: warehouse reverb -->
        <effect type="reverb" roomSize="1" damping="0" wetLevel="0"/>
        <!-- 9: lowpass -->
        <effect type="lowpass" frequency="22000.0"/>
        <!-- 10: final gain -->
        <effect type="gain" levelUnit="linear" level="1"/>
    </effects>
</DecentSampler>