<?xml version="1.0" encoding="UTF-8"?>
<DecentSampler minVersion="1.0.0">
    <ui width="812" height="375" layoutMode="relative"
        bgMode="top_left">
        <tab name="main">

            <label x="10" y="10" height="30" width="120" text="TONE" textSize="16"/>
            <menu x="10" y="40" width="120" height="30" requireSelection="true" placeholderText="Tone..." value="1">
                <option name="Piano">
                    <binding type="general" level="group" parameter="ENABLED" tags="piano" translation="fixed_value"
                             translationValue="true"/>
                    <binding type="general" level="group" parameter="ENABLED"
                             tags="saw,melodica,sine,klaviphon,kalimba,krystal,noise,groan,taisho" translation="fixed_value"
                             translationValue="false"/>
                </option>
                <option name="Klaviphon">
                    <binding type="general" level="group" parameter="ENABLED" tags="klaviphon" translation="fixed_value"
                             translationValue="true"/>
                    <binding type="general" level="group" parameter="ENABLED"
                             tags="piano,melodica,saw,sine,kalimba,krystal,noise,groan,taisho" translation="fixed_value"
                             translationValue="false"/>
                </option>
                <option name="Melodica">
                    <binding type="general" level="group" parameter="ENABLED" tags="melodica" translation="fixed_value"
                             translationValue="true"/>
                    <binding type="general" level="group" parameter="ENABLED"
                             tags="piano,saw,sine,klaviphon,kalimba,krystal,noise,groan,taisho" translation="fixed_value"
                             translationValue="false"/>
                </option>
                <option name="Kalimba">
                    <binding type="general" level="group" parameter="ENABLED" tags="kalimba" translation="fixed_value"
                             translationValue="true"/>
                    <binding type="general" level="group" parameter="ENABLED"
                             tags="piano,melodica,saw,sine,krystal,noise,groan,taisho" translation="fixed_value"
                             translationValue="false"/>
                </option>
                <option name="Crystal">
                    <binding type="general" level="group" parameter="ENABLED" tags="krystal" translation="fixed_value"
                             translationValue="true"/>
                    <binding type="general" level="group" parameter="ENABLED" tags="piano,melodica,saw,sine,noise,groan,taisho"
                             translation="fixed_value" translationValue="false"/>
                </option>
                <option name="Noise">
                    <binding type="general" level="group" parameter="ENABLED" tags="noise" translation="fixed_value"
                             translationValue="true"/>
                    <binding type="general" level="group" parameter="ENABLED" tags="piano,melodica,saw,sine,krystal,groan,taisho"
                             translation="fixed_value" translationValue="false"/>
                </option>

                <option name="Groan Tube">
                    <binding type="general" level="group" parameter="ENABLED" tags="groan" translation="fixed_value"
                             translationValue="true"/>
                    <binding type="general" level="group" parameter="ENABLED" tags="piano,melodica,saw,sine,krystal,noise,taisho"
                             translation="fixed_value" translationValue="false"/>
                </option>
                <option name="Groan Crystal">
                    <binding type="general" level="group" parameter="ENABLED" tags="groan,krystal" translation="fixed_value"
                             translationValue="true"/>
                    <binding type="general" level="group" parameter="ENABLED" tags="piano,melodica,saw,sine,noise,taisho"
                             translation="fixed_value" translationValue="false"/>
                </option>
                <option name="Taishogoto">
                    <binding type="general" level="group" parameter="ENABLED" tags="taisho" translation="fixed_value"
                             translationValue="true"/>
                    <binding type="general" level="group" parameter="ENABLED" tags="piano,melodica,saw,sine,noise,groan,krystal,klaviphon"
                             translation="fixed_value" translationValue="false"/>
                </option>
            </menu>

            <label x="140" y="10" height="30" width="120" text="EFFECT" textSize="16"/>

            <menu x="140" y="40" width="120" height="30" requireSelection="true" placeholderText="Effect..." value="1">
                <option name="None">
                    <binding type="effect" level="instrument" position="4" parameter="FX_WET_LEVEL"
                             translation="fixed_value" translationValue="0"/>
                    <binding type="effect" level="instrument" position="5" parameter="FX_MIX" translation="fixed_value"
                             translationValue="0"/>
                    <binding type="effect" level="instrument" position="6" parameter="FX_WET_LEVEL"
                             translation="fixed_value" translationValue="0"/>
                    <binding type="effect" level="instrument" position="7" parameter="FX_DRIVE"
                             translation="fixed_value" translationValue="0"/>
                    <binding type="effect" level="instrument" position="8" parameter="FX_REVERB_WET_LEVEL"
                             translation="fixed_value" translationValue="0"/>
                </option>
                <option name="Slapback">
                    <binding type="effect" level="instrument" position="4" parameter="FX_WET_LEVEL"
                             translation="fixed_value" translationValue="1"/>
                </option>
                <option name="Lofi">
                    <binding type="effect" level="instrument" position="5" parameter="FX_MIX" translation="fixed_value"
                             translationValue="1"/>
                </option>
                <option name="Wow &amp; flutter">
                    <binding type="effect" level="instrument" position="6" parameter="FX_WET_LEVEL"
                             translation="fixed_value" translationValue="1"/>
                </option>
                <option name="Foldback">
                    <binding type="effect" level="instrument" position="7" parameter="FX_DRIVE"
                             translation="fixed_value" translationValue="10"/>
                </option>
                <option name="Warehouse">
                    <binding type="effect" level="instrument" position="8" parameter="FX_REVERB_WET_LEVEL"
                             translation="fixed_value" translationValue="1"/>
                </option>
            </menu>

            <label x="270" y="10" height="30" width="120" text="ENVELOPE" textSize="16"/>

            <menu x="270" y="40" width="120" height="30" requireSelection="true" placeholderText="Envelope..."
                  value="1">

                <option name="Gate">
                    <binding type="amp" level="instrument" position="0" parameter="ENV_ATTACK" translation="fixed_value"
                             translationValue="0.05"/>
                    <binding type="amp" level="instrument" position="0" parameter="ENV_DECAY" translation="fixed_value"
                             translationValue="0.01"/>
                    <binding type="amp" level="instrument" position="0" parameter="ENV_SUSTAIN"
                             translation="fixed_value" translationValue="1"/>
                    <binding type="amp" level="instrument" position="0" parameter="ENV_RELEASE"
                             translation="fixed_value" translationValue="0.05"/>
                </option>
                <option name="Flute">
                    <binding type="amp" level="instrument" position="0" parameter="ENV_ATTACK" translation="fixed_value"
                             translationValue="0.2"/>
                    <binding type="amp" level="instrument" position="0" parameter="ENV_DECAY" translation="fixed_value"
                             translationValue="0.1"/>
                    <binding type="amp" level="instrument" position="0" parameter="ENV_SUSTAIN"
                             translation="fixed_value" translationValue="0.8"/>
                    <binding type="amp" level="instrument" position="0" parameter="ENV_RELEASE"
                             translation="fixed_value" translationValue="0.4"/>
                </option>
                <option name="Slow Flute">
                    <binding type="amp" level="instrument" position="0" parameter="ENV_ATTACK" translation="fixed_value"
                             translationValue="0.5"/>
                    <binding type="amp" level="instrument" position="0" parameter="ENV_DECAY" translation="fixed_value"
                             translationValue="0.4"/>
                    <binding type="amp" level="instrument" position="0" parameter="ENV_SUSTAIN"
                             translation="fixed_value" translationValue="0.6"/>
                    <binding type="amp" level="instrument" position="0" parameter="ENV_RELEASE"
                             translation="fixed_value" translationValue="0.6"/>
                </option>
                <option name="Ambience">
                    <binding type="amp" level="instrument" position="0" parameter="ENV_ATTACK" translation="fixed_value"
                             translationValue="1"/>
                    <binding type="amp" level="instrument" position="0" parameter="ENV_DECAY" translation="fixed_value"
                             translationValue="1"/>
                    <binding type="amp" level="instrument" position="0" parameter="ENV_SUSTAIN"
                             translation="fixed_value" translationValue="0.3"/>
                    <binding type="amp" level="instrument" position="0" parameter="ENV_RELEASE"
                             translation="fixed_value" translationValue="0.6"/>
                </option>
                <option name="Drum">
                    <binding type="amp" level="instrument" position="0" parameter="ENV_ATTACK" translation="fixed_value"
                             translationValue="0.05"/>
                    <binding type="amp" level="instrument" position="0" parameter="ENV_DECAY" translation="fixed_value"
                             translationValue="1"/>
                    <binding type="amp" level="instrument" position="0" parameter="ENV_SUSTAIN"
                             translation="fixed_value" translationValue="0"/>
                    <binding type="amp" level="instrument" position="0" parameter="ENV_RELEASE"
                             translation="fixed_value" translationValue="1"/>
                </option>
                <option name="Burst">
                    <binding type="amp" level="instrument" position="0" parameter="ENV_ATTACK" translation="fixed_value"
                             translationValue="0.05"/>
                    <binding type="amp" level="instrument" position="0" parameter="ENV_DECAY" translation="fixed_value"
                             translationValue="0.05"/>
                    <binding type="amp" level="instrument" position="0" parameter="ENV_SUSTAIN"
                             translation="fixed_value" translationValue="0"/>
                    <binding type="amp" level="instrument" position="0" parameter="ENV_RELEASE"
                             translation="fixed_value" translationValue="0.05"/>
                </option>
            </menu>

            <label x="400" y="10" height="30" width="120" text="MODWHEEL" textSize="16"/>

            <menu x="400" y="40" width="120" height="30" requireSelection="true" placeholderText="Modwheel..."
                  value="1">
                <option name="Filter">
                    <binding type="modulator" level="instrument" modulatorIndex="2"
                             parameter="MOD_AMOUNT" translation="fixed_value" translationValue="1" />
                    <binding type="modulator" level="instrument" modulatorIndex="3"
                             parameter="MOD_AMOUNT" translation="fixed_value" translationValue="0" />
                    <binding type="modulator" level="instrument" modulatorIndex="4"
                             parameter="MOD_AMOUNT" translation="fixed_value" translationValue="0" />
                    <binding type="effect" level="instrument" position="2" parameter="FX_WET_LEVEL"
                             translation="fixed_value" translationValue="0"/>
                    <binding type="modulator" level="instrument" modulatorIndex="5"
                             parameter="MOD_AMOUNT" translation="fixed_value" translationValue="0" />
                </option>
                <option name="Amp">
                    <binding type="modulator" level="instrument" modulatorIndex="2"
                             parameter="MOD_AMOUNT" translation="fixed_value" translationValue="0" />
                    <binding type="modulator" level="instrument" modulatorIndex="3"
                             parameter="MOD_AMOUNT" translation="fixed_value" translationValue="1" />
                    <binding type="modulator" level="instrument" modulatorIndex="4"
                             parameter="MOD_AMOUNT" translation="fixed_value" translationValue="0" />
                    <binding type="effect" level="instrument" position="2" parameter="FX_WET_LEVEL"
                             translation="fixed_value" translationValue="0"/>
                    <binding type="modulator" level="instrument" modulatorIndex="5"
                             parameter="MOD_AMOUNT" translation="fixed_value" translationValue="0" />
                </option>

                <option name="Time travel">
                    <binding type="modulator" level="instrument" modulatorIndex="2"
                             parameter="MOD_AMOUNT" translation="fixed_value" translationValue="0" />
                    <binding type="modulator" level="instrument" modulatorIndex="3"
                             parameter="MOD_AMOUNT" translation="fixed_value" translationValue="0" />
                    <binding type="modulator" level="instrument" modulatorIndex="4"
                             parameter="MOD_AMOUNT" translation="fixed_value" translationValue="1" />
                    <binding type="effect" level="instrument" position="2" parameter="FX_WET_LEVEL"
                             translation="fixed_value" translationValue="1"/>
                    <binding type="modulator" level="instrument" modulatorIndex="5"
                             parameter="MOD_AMOUNT" translation="fixed_value" translationValue="0" />
                </option>

                <option name="Time warp">
                    <binding type="modulator" level="instrument" modulatorIndex="2"
                             parameter="MOD_AMOUNT" translation="fixed_value" translationValue="0" />
                    <binding type="modulator" level="instrument" modulatorIndex="3"
                             parameter="MOD_AMOUNT" translation="fixed_value" translationValue="0" />
                    <binding type="modulator" level="instrument" modulatorIndex="4"
                             parameter="MOD_AMOUNT" translation="fixed_value" translationValue="1" />
                    <binding type="effect" level="instrument" position="2" parameter="FX_WET_LEVEL"
                             translation="fixed_value" translationValue="1"/>
                    <binding type="effect" level="instrument" position="2" parameter="FX_FEEDBACK"
                             translation="fixed_value" translationValue="0.8"/>
                    <binding type="modulator" level="instrument" modulatorIndex="5"
                             parameter="MOD_AMOUNT" translation="fixed_value" translationValue="0" />


                </option>

                <option name="Clip">
                    <binding type="modulator" level="instrument" modulatorIndex="2"
                             parameter="MOD_AMOUNT" translation="fixed_value" translationValue="0" />
                    <binding type="modulator" level="instrument" modulatorIndex="3"
                             parameter="MOD_AMOUNT" translation="fixed_value" translationValue="0" />
                    <binding type="modulator" level="instrument" modulatorIndex="4"
                             parameter="MOD_AMOUNT" translation="fixed_value" translationValue="0" />
                    <binding type="effect" level="instrument" position="2" parameter="FX_WET_LEVEL"
                             translation="fixed_value" translationValue="0"/>
                    <binding type="effect" level="instrument" position="2" parameter="FX_FEEDBACK"
                             translation="fixed_value" translationValue="0"/>
                    <binding type="modulator" level="instrument" modulatorIndex="5"
                             parameter="MOD_AMOUNT" translation="fixed_value" translationValue="1" />
                </option>

            </menu>

            <labeled-knob x="530" y="20" width="120" height="60" textSize="16" textColor="FF000000"
                          trackForegroundColor="FFCC00FF" trackBackgroundColor="CC000000"
                          label="VOLUME" type="float" minValue="0" maxValue="1" value="0.5" style="linear_bar" tags="volumeslider">
                <binding type="effect" level="instrument" position="9" parameter="LEVEL"
                         translation="linear" translationOutputMin="0" translationOutputMax="1"/>
            </labeled-knob>

